rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user may access only documents in their own user namespace.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Generic demo scenarios are owner-scoped.
    match /demoScenarios/{scenarioId} {
      allow read: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
    }

    // Default deny. Do not store classified, restricted, operational or
    // personal defence information in this student demonstration.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
