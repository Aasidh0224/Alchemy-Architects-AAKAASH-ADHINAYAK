rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User dashboard layout preference: read/write by owner or authenticated user
    match /userDashboards/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role in ['AIRBASE_COMMANDER', 'MISSION_PLANNER']);
      allow read: if request.auth != null;
    }

    // Tactical discrepancies and replanning events
    match /tacticalDiscrepancies/{discrepancyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public IAF assets and airbases cached telemetry
    match /iafOperationalStatus/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
