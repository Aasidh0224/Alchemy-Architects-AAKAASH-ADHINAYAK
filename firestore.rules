rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user may access only documents in their own user namespace.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Generic demonstration scenarios are owner-scoped.
    match /demoScenarios/{scenarioId} {
      allow read: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
    }

    // Default deny: this student demo must not store sensitive operational data.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
